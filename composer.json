{
    "name": "urassh/phalcon",
    "description": "Development root of the phalcon monorepo. Each package under packages/ is split into its own repository",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "urassh"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "urassh/phalcon-core": "0.2.x-dev",
                    "urassh/phalcon-framework": "0.2.x-dev",
                    "urassh/phalcon-http": "0.2.x-dev",
                    "urassh/phalcon-server": "0.2.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "urassh/phalcon-core": "^0.2",
        "urassh/phalcon-framework": "^0.2",
        "urassh/phalcon-http": "^0.2",
        "urassh/phalcon-server": "^0.2"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
