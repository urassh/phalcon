{
    "name": "urassh/phalcon-http",
    "description": "HTTP/1.1 server that runs any PSR-15 request handler",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "urassh"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "urassh/phalcon-core": "0.2.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../server",
            "options": {
                "versions": {
                    "urassh/phalcon-server": "0.2.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "urassh/phalcon-core": "^0.2",
        "urassh/phalcon-server": "^0.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Urassh\\Phalcon\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Urassh\\Phalcon\\Http\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
