{
    "name": "urassh/phalcon-core",
    "description": "Minimal PSR-7 / PSR-17 implementation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "urassh"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "provide": {
        "psr/http-factory-implementation": "1.0",
        "psr/http-message-implementation": "2.0"
    },
    "autoload": {
        "psr-4": {
            "Urassh\\Phalcon\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Urassh\\Phalcon\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
